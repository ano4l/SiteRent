# SiteRent WAAS environment template
# Copy to .env.local for local development. Add the production values in Vercel Project Settings -> Environment Variables.

# Public app URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_REDIRECT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_PLATFORM_DOMAIN=siterent.co.za

# Runtime switches
# Keep publishing paused until billing, DNS, launch review, and email handoff are ready.
NEXT_PUBLIC_PUBLISHING_PAUSED=true
PUBLISHING_PAUSED=true
# Local-only bypass for demo/smoke work. Keep false in production.
NEXT_PUBLIC_WAAS_TEST_MODE=false
WAAS_TEST_MODE=false

# Supabase
# Use the Supabase Project URL and Publishable/Anon key from Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback for older Supabase projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key from Supabase Project Settings -> API. Never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth / OAuth checklist
# For immediate email/password signup, turn off Supabase Authentication -> Providers -> Email -> Confirm Email.
# For email OTP codes, update the Supabase Magic Link or OTP email template to include {{ .Token }}.
# Supabase redirect URLs should include:
# http://localhost:3000/auth/callback
# https://your-vercel-domain/auth/callback
# Google OAuth redirect URI in Google Cloud should be:
# https://your-project-ref.supabase.co/auth/v1/callback

# Gemini website builder through Vertex AI only. No Gemini API key is used.
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLOUD_PROJECT=human-498606
GOOGLE_CLOUD_LOCATION=global

# Local Vertex AI ADC
# Run: gcloud auth application-default login
# Run: gcloud auth application-default set-quota-project human-498606
# GOOGLE_APPLICATION_CREDENTIALS can point at a local ADC/service-account file, but is not needed when using gcloud ADC.
GOOGLE_APPLICATION_CREDENTIALS=

# Vercel production Vertex AI credentials, keyless via Workload Identity Federation.
# Create these in Google Cloud IAM & Admin -> Workload Identity Federation.
# Pool name/ID example: Vercel / vercel
# Provider name/ID example: Vercel / vercel
# Provider issuer URL example: https://oidc.vercel.com/YOUR_VERCEL_TEAM_SLUG
# Provider allowed audience example: https://vercel.com/YOUR_VERCEL_TEAM_SLUG
# Provider attribute mapping: google.subject = assertion.sub
GCP_PROJECT_ID=human-498606
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=vercel@human-498606.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Legacy/key-file ADC escape hatch. Prefer Vercel OIDC above; these stay empty when service-account key creation is blocked.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS_BASE64=

# Peach Payments
# Publishing/checkout is currently paused by the flags above, but keep sandbox credentials ready for checkout testing.
PEACH_ENTITY_ID=
PEACH_SECRET_TOKEN=
PEACH_SANDBOX=true

# Email notifications
# Use either Resend or SendGrid. Resend is preferred if both are present.
RESEND_API_KEY=
SENDGRID_API_KEY=

# Vercel domain automation
# Needed only when publish/domain automation is re-enabled.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=

# Analytics/reporting
# Per-client GA4 Measurement IDs are saved in the dashboard. These server credentials are for future dashboard reporting pulls.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
